#!/usr/bin/env bash
set -euo pipefail

ROOT="/home/rnpla/projects/mlip_phonons"

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate mace_env

mlip-ft mace --curate-neb --inputs "$ROOT/assets/training_data/neutral_charge_model/curation/siv_rules.yml"

DATA_DIR="$ROOT/assets/training_data/neutral_charge_model/curated_extxyz"
RESULTS_DIR="$ROOT/assets/training_data/neutral_charge_model/3_results"
PREFIX="mace_neutral_charge_ft"
NAME="${PREFIX}_mh"
FOUNDATION_MODEL="$ROOT/assets/models/mace/mace-mpa-0-medium-f32.model"

mkdir -p \
  "$RESULTS_DIR/checkpoints" \
  "$RESULTS_DIR/logs" \
  "$RESULTS_DIR/results" \
  "$RESULTS_DIR/downloads"

cd "$RESULTS_DIR"

exec python -u -m mace.cli.run_train \
  --name "$NAME" \
  --foundation_model "$FOUNDATION_MODEL" \
  --E0s foundation \
  --pt_train_file mp \
  --atomic_numbers "[55, 82, 53]" \
  --num_samples_pt 30000 \
  --filter_type_pt combinations \
  --subselect_pt fps \
  --multiheads_finetuning True \
  --weight_pt_head 1.0 \
  --train_file "$DATA_DIR/${PREFIX}_train.extxyz" \
  --valid_file "$DATA_DIR/${PREFIX}_val.extxyz" \
  --test_file "$DATA_DIR/${PREFIX}_test.extxyz" \
  --energy_key REF_energy \
  --forces_key REF_forces \
  --energy_weight 40.0 \
  --forces_weight 100.0 \
  --stress_weight 0.0 \
  --batch_size 4 \
  --valid_batch_size 8 \
  --max_num_epochs 20 \
  --patience 8 \
  --eval_interval 1 \
  --device cuda \
  --default_dtype float32 \
  --seed 7 \
  --lr 1e-4 \
  --force_mh_ft_lr True \
  --ema \
  --ema_decay 0.99 \
  --weight_decay 5e-7